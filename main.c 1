#include "esp_camera.h"
#include "FS.h"
#include "SD_MMC.h"

// ================= CAMERA PINS =================
#define PWDN_GPIO_NUM 32
#define RESET_GPIO_NUM -1
#define XCLK_GPIO_NUM 0
#define SIOD_GPIO_NUM 26
#define SIOC_GPIO_NUM 27
#define Y9_GPIO_NUM 35
#define Y8_GPIO_NUM 34
#define Y7_GPIO_NUM 39
#define Y6_GPIO_NUM 36
#define Y5_GPIO_NUM 21
#define Y4_GPIO_NUM 19
#define Y3_GPIO_NUM 18
#define Y2_GPIO_NUM 5
#define VSYNC_GPIO_NUM 25
#define HREF_GPIO_NUM 23
#define PCLK_GPIO_NUM 22

// ================= GLOBAL =================
uint8_t image_copy[20000];
uint32_t image_len = 0;

unsigned long lastCapture = 0;

// ================= SETUP =================
void setup() {
  Serial.begin(115200);

  camera_config_t config;
  config.ledc_channel = LEDC_CHANNEL_0;
  config.ledc_timer = LEDC_TIMER_0;

  config.pin_d0 = Y2_GPIO_NUM;
  config.pin_d1 = Y3_GPIO_NUM;
  config.pin_d2 = Y4_GPIO_NUM;
  config.pin_d3 = Y5_GPIO_NUM;
  config.pin_d4 = Y6_GPIO_NUM;
  config.pin_d5 = Y7_GPIO_NUM;
  config.pin_d6 = Y8_GPIO_NUM;
  config.pin_d7 = Y9_GPIO_NUM;

  config.pin_xclk = XCLK_GPIO_NUM;
  config.pin_pclk = PCLK_GPIO_NUM;
  config.pin_vsync = VSYNC_GPIO_NUM;
  config.pin_href = HREF_GPIO_NUM;

  config.pin_sccb_sda = SIOD_GPIO_NUM;
  config.pin_sccb_scl = SIOC_GPIO_NUM;

  config.pin_pwdn = PWDN_GPIO_NUM;
  config.pin_reset = RESET_GPIO_NUM;

  config.xclk_freq_hz = 20000000;
  config.pixel_format = PIXFORMAT_JPEG;

  config.frame_size = FRAMESIZE_QQVGA;
  config.jpeg_quality = 12;
  config.fb_count = 1;

  if (esp_camera_init(&config) != ESP_OK) {
    Serial.println(" Camera init failed");
    return;
  }

  Serial.println(" Camera OK");

  if (!SD_MMC.begin()) {
    Serial.println(" SD Card Failed");
  } else {
    Serial.println(" SD Card OK");
  }
}

// ================= SAVE IMAGE =================
void save_to_sd() {

  if (image_len == 0) return;

  String path = "/garbage_" + String(millis()) + ".jpg";

  File file = SD_MMC.open(path, FILE_WRITE);
  if (!file) {
    Serial.println(" Save failed");
    return;
  }

  file.write(image_copy, image_len);
  file.close();

  Serial.println(" Saved: " + path);
}

// ================= LOOP =================
void loop() {

  //  CAPTURE EVERY 2 SEC
  if (millis() - lastCapture > 2000) {

    camera_fb_t *fb = esp_camera_fb_get();
    if (!fb) return;

    if (fb->len < sizeof(image_copy)) {
      memcpy(image_copy, fb->buf, fb->len);
      image_len = fb->len;
    } else {
      Serial.println("Image too big");
      image_len = 0;
    }

    //  SEND HEADER (VERY IMPORTANT)
    Serial.write('I');
    Serial.write('M');
    Serial.write('G');

    //  SEND LENGTH (4 bytes)
    Serial.write((uint8_t*)&image_len, 4);

    //  SEND IMAGE
    if (image_len > 0) {
      Serial.write(image_copy, image_len);
    }

    esp_camera_fb_return(fb);

    Serial.println(" Image sent (with header)");

    lastCapture = millis();
  }

  // NON-BLOCKING COMMAND READ
  static String cmd = "";

  while (Serial.available()) {
    char c = Serial.read();

    if (c == '\n') {
      cmd.trim();

      if (cmd == "SAVE") {
        Serial.println(" Saving...");
        save_to_sd();
      }

      cmd = "";
    } else {
      cmd += c;
    }
  }

  delay(5); // stability
}
